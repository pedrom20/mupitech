# Django
DJANGO_SECRET_KEY=your-secret-key-here
# Dedicated key for encrypting 2FA/TOTP secrets — generate with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this separate from DJANGO_SECRET_KEY and back it up: losing it
# invalidates every user's 2FA enrolment (they'll need to re-enroll).
MFA_ENCRYPTION_KEY=your-fernet-key-here
# Optional — Duo Security push 2FA (mfa/duo.py), from an "Auth API"
# application created in the Duo Admin Panel. TOTP keeps working with
# these unset; Duo push just stays unavailable until all three are set.
DUO_IKEY=
DUO_SKEY=
DUO_HOST=
# Optional — privacyIDEA 2FA (mfa/privacyidea.py), a self-hosted
# privacyIDEA server deployed separately (see deploy/privacyidea/).
# Needs an admin account privacyIDEA-side for this Fleet Manager to
# authenticate as, and a realm for its users to enroll tokens in.
# Stays unavailable until all four are set.
PRIVACYIDEA_URL=
PRIVACYIDEA_ADMIN_USER=
PRIVACYIDEA_ADMIN_PASSWORD=
PRIVACYIDEA_REALM=
# Optional — the resolver `PRIVACYIDEA_REALM` uses, ONLY needed if it's
# privacyIDEA's own "internal" resolver (pi-manage resolver
# create_internal) — the Fleet Manager then auto-creates each user
# there on first enrolment. Leave unset for an external LDAP/SQL
# resolver that already has these users.
PRIVACYIDEA_RESOLVER=
# Set to false if the server above uses a self-signed certificate
# (the common case for a self-hosted instance — see deploy/privacyidea/).
PRIVACYIDEA_VERIFY_SSL=true
# Optional — AD/LDAP login (fleet_manager/ldap_backend.py). Stays off
# until all four are set; new LDAP-authenticated users land as
# "viewer" (Django's default for a groupless user) until an admin
# assigns a real role from the Users page.
AUTH_LDAP_SERVER_URI=
AUTH_LDAP_BIND_DN=
AUTH_LDAP_BIND_PASSWORD=
AUTH_LDAP_USER_SEARCH_BASE=
# Optional — default '(sAMAccountName=%(user)s)' assumes Active
# Directory; for non-AD LDAP try '(uid=%(user)s)'.
AUTH_LDAP_USER_SEARCH_FILTER=
DJANGO_DEBUG=False
ALLOWED_HOSTS=fleet.yourdomain.com,localhost
LANGUAGE_CODE=pt
TIME_ZONE=Europe/Lisbon

# Database
DB_PASSWORD=your-strong-password-here

# Web
WEB_PORT=9000

# CSRF
CSRF_TRUSTED_ORIGINS=https://fleet.yourdomain.com,http://localhost:9000

# Player polling
PLAYER_POLL_INTERVAL=60

# Shared secret for player phone-home registration (empty = open mode)
PLAYER_REGISTER_TOKEN=

# Cloudflare Tunnel (use with: docker compose --profile tunnel up -d)
CLOUDFLARE_TUNNEL_TOKEN=

# Watchtower
WATCHTOWER_POLL_INTERVAL=300
WATCHTOWER_HTTP_API_TOKEN=

# Imagens Anthias usadas no provisioning dos players (ver docs/anthias-version-analysis.md).
# Por omissão continuam a apontar para o fork alex1981-tech: o Anthias oficial ainda não
# expõe viewlog/screenshot/schedule-slots/cec/ir, dos quais o Fleet Manager depende.
ANTHIAS_IMAGE_REGISTRY=ghcr.io/alex1981-tech
ANTHIAS_IMAGE_TAG_SUFFIX_PI4=latest-pi4-64
ANTHIAS_IMAGE_TAG_SUFFIX_PI5=latest-pi5-64

# Repositório GitHub usado pela verificação de atualizações da própria dashboard
UPDATE_CHECK_GITHUB_REPO=pedrom20/mupiteck

# Funcionalidades opcionais (desativadas por omissão neste deployment)
FEATURE_CCTV_ENABLED=False
